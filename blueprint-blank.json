{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Create Not Learn Editor on a blank site (v0.5.0)",
		"author": "getdave",
		"description": "Create Not Learn Editor v0.5.0, on WordPress 7.1, with Gutenberg and WordPress's default theme, on a fresh site with no demo content."
	},
	"landingPage": "/wp-admin/admin.php?page=create-not-learn-editor",
	"preferredVersions": {
		"php": "8.3",
		"wp": "7.1"
	},
	"features": {
		"networking": true
	},
	"steps": [
		{
			"step": "login"
		},
		{
			"step": "writeFile",
			"path": "/wordpress/wp-content/mu-plugins/cnl-playground-canvas-fix.php",
			"data": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/Automattic/create-not-learn-editor/refs/tags/playground-v0.5.0/playground-canvas-fix.php"
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://downloads.wordpress.org/plugin/gutenberg.24.0.0.zip"
			},
			"options": {
				"activate": true
			},
			"progress": {
				"caption": "Installing Gutenberg"
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/Automattic/create-not-learn-editor/refs/tags/playground-v0.5.0/create-not-learn-editor.zip"
			},
			"options": {
				"activate": true
			},
			"progress": {
				"caption": "Installing Create Not Learn Editor"
			}
		}
	]
}
