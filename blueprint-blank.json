{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Create Not Learn Editor on a blank site (getdave/design-styles-fonts-links)",
		"author": "getdave",
		"description": "Create Not Learn Editor from the getdave/design-styles-fonts-links branch, with Gutenberg and WordPress's default theme, on a fresh site with no demo content."
	},
	"landingPage": "/wp-admin/admin.php?page=create-not-learn-editor",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"features": {
		"networking": true
	},
	"steps": [
		{
			"step": "login"
		},
		{
			"step": "writeFile",
			"path": "/wordpress/wp-content/mu-plugins/cnl-playground-canvas-fix.php",
			"data": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/getdave/create-not-learn-editor/refs/playground/getdave/design-styles-fonts-links/playground-canvas-fix.php"
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://downloads.wordpress.org/plugin/gutenberg.24.0.0.zip"
			},
			"options": {
				"activate": true
			},
			"progress": {
				"caption": "Installing Gutenberg"
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/getdave/create-not-learn-editor/refs/playground/getdave/design-styles-fonts-links/create-not-learn-editor.zip"
			},
			"options": {
				"activate": true
			},
			"progress": {
				"caption": "Installing Create Not Learn Editor"
			}
		}
	]
}
